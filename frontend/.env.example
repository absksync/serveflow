# Copy to .env.local and fill in. Never commit .env.local.
#
# Supabase dashboard -> Project Settings -> API Keys
# Use the PUBLISHABLE key (sb_publishable_...). Never put the secret key
# (sb_secret_...) or a service_role key in a NEXT_PUBLIC_ variable: it is
# shipped to every visitor's browser and bypasses Row Level Security.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
